{
  "name": "@tutaj/desktop",
  "version": "0.2.0",
  "private": true,
  "description": "Tutaj — wideorozmowy dla 2–4 osób. Aplikacja z wbudowanym serwerem (host w sieci LAN).",
  "author": "Lorem Ipsum (https://tutaj.eu.org)",
  "license": "AGPL-3.0-only",
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64",
    "pack": "electron-builder --win dir --x64"
  },
  "dependencies": {
    "@tutaj/server": "0.1.0"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.16.1"
  },
  "build": {
    "appId": "org.eu.tutaj.desktop",
    "productName": "Tutaj",
    "copyright": "© 2026 Lorem Ipsum",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.mjs",
      "preload.cjs",
      "picker-preload.cjs",
      "picker.html",
      "offline.html",
      "logo.webp",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../client/dist",
        "to": "client"
      }
    ],
    "asarUnpack": [
      "**/node_modules/mediasoup/worker/out/Release/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "Tutaj-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tutaj",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "Tutaj (Lorem Ipsum)",
      "language": "1045"
    }
  },
  "homepage": "https://github.com/kauczu/tutaj",
  "repository": {
    "type": "git",
    "url": "https://github.com/kauczu/tutaj.git"
  },
  "tutaj": {
    "defaultServer": "https://o.tutaj.eu.org"
  }
}
