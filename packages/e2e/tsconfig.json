{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    // Type-check against the server's sources, so this works before the server is built
    // (at runtime the tests import the built package).
    "paths": { "@tutaj/server": ["../server/src/server.ts"] }
  },
  "include": ["tests", "playwright.config.ts"]
}
