{
  "name": "@tutaj/server",
  "version": "0.7.8",
  "private": true,
  "description": "Serwer sygnalizacji Tutaj (WebSocket) + hosting klienta + poświadczenia TURN.",
  "type": "module",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "bin": {
    "tutaj-server": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "mediasoup": "3.27.1",
    "selfsigned": "5.5.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@tutaj/shared": "0.7.8",
    "@types/node": "22.20.4",
    "@types/ws": "8.18.1",
    "tsx": "4.23.14"
  },
  "files": [
    "dist"
  ],
  "license": "AGPL-3.0-only",
  "author": "Lorem Ipsum (https://tutaj.eu.org)",
  "homepage": "https://github.com/kauczu/tutaj",
  "repository": {
    "type": "git",
    "url": "https://github.com/kauczu/tutaj.git"
  }
}
